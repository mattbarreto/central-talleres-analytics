DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
SECRET_KEY=GENERAR_CON_SECRETS_TOKEN_URLSAFE_64
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160
CORS_ORIGINS=https://tu-dominio.com
APP_DOMAIN=app.example.com
PROXY_NETWORK=proxy_network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
APP_PORT=8000
SQL_POOL_PRE_PING=false
SQL_POOL_SIZE=5
SQL_MAX_OVERFLOW=10
SQL_POOL_TIMEOUT=30
LOG_LEVEL=INFO
LOG_JSON=true
REPORT_JOBS_TTL_SECONDS=3600
REPORT_JOBS_MAX_JOBS=300
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=7
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.tu-dominio.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASSWORD=tu_password_smtp
SMTP_STARTTLS=true
SMTP_SENDER_EMAIL=no-reply@tu-dominio.com
CERTIFICATES_RETENTION_DAYS=60
INSIGHTS_CACHE_PATH=generated/cache/insights_cache.json
INSIGHTS_CACHE_MAX_ENTRIES=128
REVOKED_ACCESS_TOKENS_PATH=generated/cache/revoked_access_tokens.json
REVOKED_REFRESH_TOKENS_PATH=generated/cache/revoked_refresh_tokens.json
