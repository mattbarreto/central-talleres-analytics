# Supabase (recomendado): postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Local: postgresql://user:password@localhost:5432/training_center
DATABASE_URL=postgresql://user:password@localhost:5432/training_center
SECRET_KEY=generate_with_python_secrets_token_urlsafe_64
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_PORT=8000
# Si la DB es remota (Supabase), suele convenir false para reducir RTT por request.
SQL_POOL_PRE_PING=false
SQL_POOL_SIZE=5
SQL_MAX_OVERFLOW=10
SQL_POOL_TIMEOUT=30
LOG_LEVEL=INFO
LOG_JSON=true
REPORT_JOBS_TTL_SECONDS=3600
REPORT_JOBS_MAX_JOBS=300
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=7
EMAIL_DELIVERY_MODE=demo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SENDER_EMAIL=
CERTIFICATES_RETENTION_DAYS=60
INSIGHTS_CACHE_PATH=generated/cache/insights_cache.json
INSIGHTS_CACHE_MAX_ENTRIES=128
REVOKED_ACCESS_TOKENS_PATH=generated/cache/revoked_access_tokens.json
REVOKED_REFRESH_TOKENS_PATH=generated/cache/revoked_refresh_tokens.json
